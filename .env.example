# =============================================================================
# MediBook – Healthcare Platform Environment Configuration
# =============================================================================
# Replace these values with your Firebase Project credentials from the
# Firebase Console (Project Settings > General > Your Apps > Web App).
#
# When deploying to production, paste these into assets/js/config/firebase-config.js
# or inject them via your CI/CD build pipeline.
# =============================================================================

FIREBASE_API_KEY="AIzaSyYourActualApiKeyHere"
FIREBASE_AUTH_DOMAIN="medibook-health.firebaseapp.com"
FIREBASE_PROJECT_ID="medibook-health"
FIREBASE_STORAGE_BUCKET="medibook-health.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="123456789012"
FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# Optional Hospital Operations Configuration
HOSPITAL_NAME="Metropolitan Central Hospital & Health Alliance"
HOSPITAL_EMAIL="admin@medibook.health"
HOSPITAL_PHONE="+1 (800) 432-6334"
DEFAULT_CURRENCY="USD"
DEFAULT_CURRENCY_SYMBOL="$"

# =============================================================================
# MediBook AI Healthcare Assistant Configuration
# =============================================================================
# Set your Gemini API key (from Google AI Studio: https://aistudio.google.com/)
# to enable direct LLM reasoning via the secure backend proxy.
# If omitted or left empty, MediBook's built-in clinical NLP engine operates automatically.
GEMINI_API_KEY=""
PORT=3000
